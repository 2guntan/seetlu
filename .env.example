# --- backend ---
SEETLU_ENV=dev                     # staging/prod refuse dev secrets and DEV_FIXED_OTP
DATABASE_URL=postgresql+psycopg://seetlu:seetlu@db:5432/seetlu
REDIS_URL=redis://redis:6379/0
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789   # >= 32 bytes; generate with: openssl rand -hex 32
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET_CLIPS=seetlu-clips
S3_PUBLIC_ENDPOINT=http://localhost:9000   # host used in presigned GET links (browser, WhatsApp media)
APP_BASE_URL=http://localhost:5173
DEV_FIXED_OTP=000000

# --- messaging ---
MESSAGING_PROVIDER=mock            # mock | whatsapp_cloud
MOCK_WHATSAPP_URL=http://mock-whatsapp:8025
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# --- edge agent (on the box) ---
SEETLU_API_URL=http://api:8000
KIT_SERIAL=DEV-KIT-0001
KIT_CLAIM_TOKEN=dev-claim-token
FRIGATE_URL=http://frigate:5000
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Shop phone raw-notification sealing (docs/09). Generate: docker compose run --rm api python -m seetlu.phone.crypto
# The API and phones get the public key; only the worker gets the private key.
RAW_PUBLIC_KEY_B64=
RAW_PRIVATE_KEY_B64=
