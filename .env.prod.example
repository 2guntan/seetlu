# Production settings (ops/docker-compose.prod.yml). `ops/vm/gen-secrets.sh` writes .env.prod from this
# file with fresh random secrets, and .env.worker with the raw-notification private key (worker only).
# Never commit .env.prod or .env.worker.

SEETLU_ENV=prod                      # prod | staging (staging may use MESSAGING_PROVIDER=mock)
SEETLU_DOMAIN=app.example.sn         # owner/installer PWA + API; clips use files.<domain>
ACME_EMAIL=ops@example.sn            # Let's Encrypt account
CADDY_TLS=                           # empty = Let's Encrypt; "internal" = local CA (smoke tests only)

# --- generated by gen-secrets.sh ---
POSTGRES_PASSWORD=__RANDOM__
MINIO_ROOT_USER=seetlu
MINIO_ROOT_PASSWORD=__RANDOM__
JWT_SECRET=__RANDOM__
GRAFANA_ADMIN_PASSWORD=__RANDOM__
RAW_PUBLIC_KEY_B64=__RSA_PUBLIC__

# --- backend ---
S3_BUCKET_CLIPS=seetlu-clips
DEV_FIXED_OTP=

# --- WhatsApp Business Platform (docs/07; docs/12 human task: Meta account + templates) ---
MESSAGING_PROVIDER=whatsapp_cloud
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=__RANDOM__

# --- backups (docs/09: daily full + WAL, 30 days) ---
BACKUP_S3_BUCKET=seetlu-backups
BACKUP_RETENTION_DAYS=30
# Optional second copy on another machine/provider IN SENEGAL (docs/09 hosting rule). Empty = off.
BACKUP_OFFSITE_S3_ENDPOINT=
BACKUP_OFFSITE_S3_BUCKET=
BACKUP_OFFSITE_ACCESS_KEY_ID=
BACKUP_OFFSITE_SECRET_ACCESS_KEY=

# --- monitoring ---
ALERT_WEBHOOK_URL=http://localhost:9/disabled   # Alertmanager webhook receiver (ops/runbooks/incident.md)
